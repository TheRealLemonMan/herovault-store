# Store API CORS (storefront origin)
STORE_CORS=http://localhost:8000

# Admin dashboard CORS
ADMIN_CORS=http://localhost:5173,http://localhost:9000

# Auth CORS (admin + storefront)
AUTH_CORS=http://localhost:5173,http://localhost:9000,http://localhost:8000

# Replace with long random strings in production
JWT_SECRET=replace-with-a-long-random-string
COOKIE_SECRET=replace-with-a-long-random-string

# Supabase Session Pooler — port 5432 (not 6543). SSL required.
DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-us-west-2.pooler.supabase.com:5432/postgres?sslmode=require

# Do not set REDIS_URL. This project uses Medusa's in-memory event bus in development.
