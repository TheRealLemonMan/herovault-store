# Medusa v2 backend (storefront talks only to this API)
NEXT_PUBLIC_MEDUSA_BACKEND_URL=http://localhost:9000

# Publishable API key from Medusa Admin → Settings → Publishable API Keys
NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY=pk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Default storefront country prefix (Ecuador, USD)
NEXT_PUBLIC_DEFAULT_REGION=ec

# Storefront origin
NEXT_PUBLIC_BASE_URL=http://localhost:8000

# Optional Stripe (not required — checkout uses Medusa manual payment)
NEXT_PUBLIC_STRIPE_KEY=

NODE_ENV=development
